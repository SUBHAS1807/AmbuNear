# Server Port
PORT=5000

# Environment Mode: development | production | test
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ambunear?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ambunear

# JSON Web Token Secret & Expiration
JWT_SECRET=your_jwt_secret_change_in_production_min32chars
JWT_EXPIRES_IN=7d

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Optional: Cookie secret
COOKIE_SECRET=your_cookie_secret_key_change_in_production

# Optional: Map Provider API Key (Google Maps or Mapbox)
# If omitted, application uses automatic built-in Haversine distance and interactive SVG fallback maps
MAPS_API_KEY=
